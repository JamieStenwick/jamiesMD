{
    "tasks": [
        {
            "type": "cppbuild",
            "label": "C/C++: g++.exe build active file",
            "command": "/usr/bin/g++",
            "args": [
                "-fdiagnostics-color=always",
                "-g",
                "-ggdb", // debugging build
                // "-O2", release build
                // "-DNDEBUG", release build
                "-pedantic-errors",
                "-Werror",
                "-std=c++23",
                // "-I./source/includes", for providing a search directory for header files
                "${fileDirname}\\**.cpp", // for compiling all files in a directory "${file}",
                "-o",
                "${fileDirname}\\${fileBasenameNoExtension}"
            ],
            "options": {
                "cwd": "/usr/bin"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "Task generated by Debugger."
        }
    ],
    "version": "2.0.0"
}
